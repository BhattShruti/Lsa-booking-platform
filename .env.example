# =============================================================================
# HabotConnect LSA Booking Platform — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env with real secrets to source control.
#
# For Docker Compose, these variables are automatically read from .env
# in the same directory as docker-compose.yml.
# =============================================================================

# ── Flask Application ─────────────────────────────────────────────────────────
FLASK_APP=run.py
# Options: development | testing | production
FLASK_ENV=production

# ── Application Secrets ────────────────────────────────────────────────────────
# REQUIRED in production. Use a cryptographically random value (min 32 chars).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-secure-random-secret-key-min-32-chars
JWT_SECRET_KEY=replace-with-secure-random-jwt-secret-key-min-32-chars
WEBHOOK_SECRET=replace-with-secure-random-webhook-secret-key-min-32-chars

# ── Database Configuration ─────────────────────────────────────────────────────
# Production: PostgreSQL REQUIRED.
# Development: can use sqlite:///dev.db
# Docker Compose: DATABASE_URL is auto-constructed from POSTGRES_* vars in docker-compose.yml
#   (You do NOT need to set DATABASE_URL manually when using docker-compose.yml)
DATABASE_URL=postgresql://habot:change-me-password@localhost:5432/habot_lsa_booking

# ── PostgreSQL Credentials (Docker Compose only) ──────────────────────────────
# These are used by the 'db' service in docker-compose.yml.
POSTGRES_USER=habot
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=habot_lsa_booking

# ── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Payment Gateway ───────────────────────────────────────────────────────────
# In Docker: uses web service hostname (set automatically in docker-compose.yml)
# Locally: point to your running Flask instance
MOCK_PAYMENT_URL=http://localhost:5000/api/v1/mock-payment-gateway/charge

# ── Webhook Configuration ─────────────────────────────────────────────────────
# Maximum age (seconds) of webhook timestamps before rejection (replay protection)
WEBHOOK_TOLERANCE=300

# ── Pagination ────────────────────────────────────────────────────────────────
PAGINATION_MAX_PER_PAGE=50

# ── Gunicorn (Docker/Production) ──────────────────────────────────────────────
# Number of worker processes. Rule of thumb: 2 * CPU_cores + 1 for I/O-bound
# 3 is a safe baseline for a single-vCPU container.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5

# ── Application Port ──────────────────────────────────────────────────────────
APP_PORT=5000
